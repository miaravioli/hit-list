{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "hit-list",
  "version": "0.1.0",
  "identifier": "com.mia.hit-list",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "receipt",
        "title": "receipt",
        "url": "receipt",
        "visible": false,
        "width": 350,
        "height": 500,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "x": 30,
        "y": 60,
        "resizable": false,
        "dragDropEnabled": false
      },
      {
        "label": "table",
        "title": "table",
        "url": "table",
        "visible": false,
        "width": 600,
        "height": 400,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "x": 880,
        "y": 545,
        "resizable": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "Info.plist"
    }
  }
}
