{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "desktop-apps",
  "version": "0.1.0",
  "identifier": "com.mia.desktop-apps",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "receipt",
        "url": "reciept/index.html",
        "visible": false,
        "width": 300,
        "height": 500
      },
      {
        "title": "table",
        "url": "table/index.html",
        "visible": false,
        "width": 300,
        "height": 500
      },
      {
        "title": "photobooth",
        "url": "photobooth/index.html",
        "visible": false,
        "width": 300,
        "height": 500
      },
      {
        "title": "spotify",
        "url": "spotify/index.html",
        "visible": false,
        "width": 300,
        "height": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
